#!/usr/bin/env bash
# Shared file previews for shell fzf, fzf-tab, and fzf-lua.
set -o pipefail

preview_zip() {
    unzip -l "$1" | sed -n '1,200p'
}

preview_pdf() {
    local file=$1

    if command -v pdftotext >/dev/null 2>&1; then
        pdftotext -l 3 "$file" - | sed -n '1,200p'
    elif command -v pdfinfo >/dev/null 2>&1; then
        pdfinfo "$file"
    else
        file -- "$file"
    fi
}

if (($# == 0)); then
    printf 'usage: %s [BAT_OPTIONS...] FILE[:LINE[:COL]]\n' "$0" >&2
    exit 1
fi

# fzf-lua passes bat options first and the filename last.
bat_options=()
while (($# > 1)); do
    bat_options+=("$1")
    shift
done
file=$1

if [[ $file == '~/'* ]]; then
    file="$HOME/${file:2}"
fi

# Prefer an existing filename, even if it contains colons. Otherwise, resolve
# grep-style FILE:LINE:COL or FILE:LINE entries and highlight the matching line.
if [[ ! -e "$file" ]]; then
    if [[ $file =~ ^(.+):([0-9]+):([0-9]+)(:.*)?$ && -f ${BASH_REMATCH[1]} ]]; then
        file=${BASH_REMATCH[1]}
        bat_options+=("--highlight-line=${BASH_REMATCH[2]}")
    elif [[ $file =~ ^(.+):([0-9]+)(:.*)?$ && -f ${BASH_REMATCH[1]} ]]; then
        file=${BASH_REMATCH[1]}
        bat_options+=("--highlight-line=${BASH_REMATCH[2]}")
    fi
fi

# Absolute paths also protect filenames beginning with '-' from option parsing.
if [[ $file != /* ]]; then
    file="$PWD/$file"
fi

if [[ -d "$file" ]]; then
    exec eza --oneline --all --tree --level=3 \
        --group-directories-first --color=always \
        --ignore-glob '.DS_Store|.localized|.idea|.vscode' -- "$file"
fi

if [[ ! -f "$file" || ! -r "$file" ]]; then
    exec file -- "$file"
fi

if [[ ! -s "$file" ]]; then
    printf 'Empty file: %s\n' "$file"
    exit 0
fi

# These formats have dedicated viewers.
case "$file" in
*.plist | *.mobileconfig)
    exec plutil -p -- "$file"
    ;;
*.sqlite | *.sqlite3 | *.db)
    exec sqlite3 -readonly "$file" '.tables' \
        'SELECT name, type FROM sqlite_master ORDER BY type, name LIMIT 50;'
    ;;
*.zip | *.jar | *.war | *.ipa)
    preview_zip "$file"
    exit
    ;;
*.tar | *.tar.gz | *.tgz | *.tar.bz2 | *.tbz2 | *.tar.xz | *.txz)
    tar -tf "$file" | sed -n '1,200p'
    exit
    ;;
esac

# Inspect contents so images and ZIP archives work without a file extension.
mime=$(file --brief --dereference --mime -- "$file")
case "$mime" in
image/*)
    exec "${BASH_SOURCE[0]%/*}/preview-image" "$file"
    ;;
application/pdf*)
    preview_pdf "$file"
    ;;
application/zip*)
    preview_zip "$file"
    ;;
*charset=binary*)
    file -- "$file"
    ;;
*)
    exec bat --color=always --paging=never \
        --theme="${BAT_THEME:-ansi}" --style=numbers,changes \
        "${bat_options[@]}" -- "$file"
    ;;
esac
