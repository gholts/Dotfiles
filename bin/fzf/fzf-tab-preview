#!/usr/bin/env bash
# fzf-tab supplies: real path, insertion word, completion group, description.
set -o pipefail

preview_host() {
    local host=$1

    if [[ -r "$HOME/.ssh/config" ]]; then
        awk -v host="$host" '
            /^Host[ \t]+/ {
                found = 0
                for (i = 2; i <= NF; i++) {
                    if ($i == host) {
                        found = 1
                    }
                }
            }
            found { print }
        ' "$HOME/.ssh/config"
    fi

    awk -v host="$host" '
        !/^#/ {
            for (i = 2; i <= NF; i++) {
                if ($i == host) {
                    print
                    break
                }
            }
        }
    ' /etc/hosts
}

candidate_path=${1:-}
word=${2:-}
group=${3:-}
description=${4:-}

if [[ -e "$candidate_path" || -L "$candidate_path" ]]; then
    exec "${BASH_SOURCE[0]%/*}/preview" "$candidate_path"
fi

if [[ -n "$group" ]]; then
    printf 'Group: %s\n' "$group"
fi
if [[ -n "$word" ]]; then
    printf 'Word:  %s\n' "$word"
fi
if [[ -n "$description" && "$description" != "$word" ]]; then
    printf 'Desc:  %s\n' "$description"
fi
if [[ -z "$word" ]]; then
    exit 0
fi

# File candidates already use the shared previewer. Handle completion metadata.
shopt -s nocasematch
case "$group" in
*process*)
    if [[ ! $word =~ ^[0-9]+$ ]]; then
        exit 1
    fi
    ps -p "$word" -o pid=,ppid=,user=,%cpu=,%mem=,etime=,stat=,command=
    ;;
*command* | *builtin* | *external* | *function* | *alias*)
    type -a -- "$word" 2>/dev/null
    man -P cat "$word" 2>/dev/null | col -bx | sed -n '1,120p'
    ;;
*host* | *domain* | *ip\ address*)
    preview_host "$word"
    ;;
*branch* | *tag* | *commit*)
    git --no-pager show --color=always --stat --decorate \
        --no-ext-diff --end-of-options "$word" -- 2>/dev/null |
        sed -n '1,240p'
    ;;
*formula* | *cask*)
    HOMEBREW_COLOR=1 brew info "$word" 2>/dev/null
    ;;
esac
